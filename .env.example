# Copy this file to .env and fill in the values from Supabase:
# Project Settings -> API (Project URL, anon public key, service_role key).
# .env is git-ignored. Never commit real keys.

# Live project. The two VITE_ values are built into the website and are safe to be public:
# row level security decides what they can do. Add them to Vercel too.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Live project, for scripts on your computer only (image upload). Full access to the database:
# never prefix it with VITE_, never add it to Vercel, never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Test project, used by scripts run with --test and by the end-to-end tests.
TEST_SUPABASE_URL=https://your-test-project-ref.supabase.co
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
